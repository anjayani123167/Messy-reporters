{
  "name": "officedesk-server",
  "version": "0.1.0",
  "private": true,
  "description": "Auth (email OTP), device registry, WebRTC signaling and TURN credentials for OfficeDesk",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "nodemailer": "^7.0.10",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
