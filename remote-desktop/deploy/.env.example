# Copy to .env (never commit .env) and fill in.

# Name shown in the app and in sign-in emails.
APP_NAME=OfficeDesk

# Only these email domains can sign in (comma-separated, exact match, no subdomains).
ALLOWED_EMAIL_DOMAINS=kantor.co.id

# Domains pointing (A record) at this VPS, and its public IPv4 address.
DESK_DOMAIN=desk.kantor.co.id
TURN_DOMAIN=turn.kantor.co.id
PUBLIC_IP=203.0.113.10

# TURN relay. 8443 gets through most ISP / office firewalls; 3478 is often blocked.
TURN_PORT=8443
# Generate with:  openssl rand -hex 32
TURN_SECRET=

# The office mailbox that sends sign-in codes (cPanel: Email Accounts → Connect Devices).
SMTP_HOST=mail.kantor.co.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@kantor.co.id
SMTP_PASS=
MAIL_FROM=noreply@kantor.co.id
